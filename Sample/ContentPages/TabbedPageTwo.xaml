<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.ViewModels" xmlns:inject="clr-namespace:ShellInject.Extensions;assembly=ShellInject"
             inject:ShellInjectPageExtensions.ViewModelType="{x:Type vm:InboxViewModel}"
             x:Class="Sample.ContentPages.TabbedPageTwo" x:DataType="vm:InboxViewModel" Title="Workspace">
    <ScrollView><VerticalStackLayout Style="{StaticResource PageContent}">
        <Label Text="WORKSPACE / TAB 1" Style="{StaticResource Eyebrow}" />
        <Label Text="Your tab has a message." Style="{StaticResource PageTitle}" />
        <Label Text="TabbedPageTwo is explicitly bound to InboxViewModel in XAML. Explicit ViewModelType wins over naming conventions." Style="{StaticResource BodyMuted}" />
        <Border Style="{StaticResource ResultCard}"><VerticalStackLayout Spacing="12">
            <Label Text="DataReceivedAsync" Style="{StaticResource Eyebrow}" />
            <Label Text="{Binding DataReceivedText}" Style="{StaticResource Heading}" AutomationId="TabPayload" />
        </VerticalStackLayout></Border>
        <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12">
            <Label Text="Select by page type" Style="{StaticResource Heading}" />
            <Label Text="Both tabs are materialized in AppShell.xaml so the typed API can find Overview directly. Uncreated templates are not searched by type." Style="{StaticResource BodyMuted}" />
            <Border Style="{StaticResource CodeCard}"><Label Text="ChangeTabAsync&lt;TabbedPageOne&gt;(&#10;    parameter: reference);" Style="{StaticResource Code}" /></Border>
            <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanInteract}">
                <Button Text="Send to Overview by type" Command="{Binding OpenOverviewCommand}" />
                <Button Text="Return to navigation lab" Command="{Binding ReturnToLabCommand}" Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout></Border>
        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" />
        <Label Text="SOURCE / TabbedPageTwo.xaml + InboxViewModel.cs" Style="{StaticResource Caption}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
