<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.ViewModels" x:Class="Sample.ContentPages.SamplePage2" x:DataType="vm:StackStepViewModel" Title="Prepare · Shell stack">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <Label Text="SHELL STACK / INTERMEDIATE STEP" Style="{StaticResource Eyebrow}" />
            <Label Text="Back one step." Style="{StaticResource PageTitle}" />
            <Label Text="The lab built this page underneath Review. PushMultiStackAsync sends its initial parameter only to the final page, not every page in the stack." Style="{StaticResource BodyMuted}" />
            <Border Style="{StaticResource ResultCard}"><VerticalStackLayout Spacing="12">
                <Label Text="RETURNED FROM REVIEW" Style="{StaticResource Eyebrow}" />
                <Label Text="{Binding ReverseDataText}" />
            </VerticalStackLayout></Border>
            <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12">
                <Label Text="A different name. Same binding." Style="{StaticResource Heading}" />
                <Label Text="SamplePage2 is mapped to StackStepViewModel explicitly at startup. No ViewModel construction is needed in this page's code-behind." Style="{StaticResource BodyMuted}" />
                <Border Style="{StaticResource CodeCard}"><Label Text="options.RegisterViewModel&lt;&#10;    SamplePage2, StackStepViewModel&gt;();" Style="{StaticResource Code}" /></Border>
            </VerticalStackLayout></Border>
            <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanInteract}">
                <Button Text="Continue to Review again" Command="{Binding ContinueCommand}" />
                <Button Text="Return to lab by page type" Command="{Binding ReturnToLabCommand}" Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" />
            <Label Text="SOURCE / StackStepViewModel.cs + MauiProgram.cs" Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
