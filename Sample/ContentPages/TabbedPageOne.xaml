<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.ViewModels" x:Class="Sample.ContentPages.TabbedPageOne" x:DataType="vm:TabbedPageOneViewModel" Title="Workspace">
    <ScrollView><VerticalStackLayout Style="{StaticResource PageContent}">
        <Label Text="WORKSPACE / TAB 0" Style="{StaticResource Eyebrow}" />
        <Label Text="Switch context. Keep data." Style="{StaticResource PageTitle}" />
        <Label Text="Tabs are existing Shell destinations. Selecting one sends forward data without pushing a details page." Style="{StaticResource BodyMuted}" />
        <Border Style="{StaticResource ResultCard}"><VerticalStackLayout Spacing="12">
            <Label Text="LATEST FORWARD DATA" Style="{StaticResource Eyebrow}" />
            <Label Text="{Binding DataReceivedText}" />
        </VerticalStackLayout></Border>
        <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12">
            <Label Text="Select by index" Style="{StaticResource Heading}" />
            <Label Text="Index 1 is the Inbox in this ShellSection. This page uses conventional ViewModel binding." Style="{StaticResource BodyMuted}" />
            <Border Style="{StaticResource CodeCard}"><Label Text="ChangeTabAsync(tabIndex: 1,&#10;    parameter: reference);" Style="{StaticResource Code}" /></Border>
            <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanInteract}">
                <Button Text="Send reference to Inbox" Command="{Binding OpenInboxCommand}" />
                <Button Text="Return to navigation lab" Command="{Binding ReturnToLabCommand}" Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout></Border>
        <Label Text="Tapping a tab header uses normal Shell navigation; only the demo buttons send a new payload." Style="{StaticResource Caption}" />
        <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" />
        <Label Text="SOURCE / TabbedPageOneViewModel.cs + AppShell.xaml" Style="{StaticResource Caption}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
