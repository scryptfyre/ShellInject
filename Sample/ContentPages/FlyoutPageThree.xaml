<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.ViewModels"
             x:DataType="vm:FlyoutPageThreeViewModel"
             Title="Replace Target"
             BackgroundColor="#F7F8FC"
             x:Class="Sample.ContentPages.FlyoutPageThree">
    <VerticalStackLayout Spacing="16" Padding="20,24">
        <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 20" Padding="20">
            <VerticalStackLayout Spacing="10">
                <Label Text="ReplaceAsync target" TextColor="#111827" FontSize="24" FontAttributes="Bold" />
                <Label Text="This flyout item can be selected directly, or replaced from the examples page." TextColor="#6B7280" />
                <Label Text="Received parameter" TextColor="#6B7280" FontSize="12" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding DataReceivedText}" TextColor="#111827" FontSize="16" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
