<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contentPages="clr-namespace:Sample.ContentPages"
    FlyoutBehavior="Flyout"
    Title="ShellInject Sample">
    
    <FlyoutItem 
        Route="MainPage"
        Title="Examples">
        <ShellContent
            Title="Examples"
            ContentTemplate="{DataTemplate contentPages:MainPage}"
            Route="MainPage" />
    </FlyoutItem>
    
    <FlyoutItem
        Route="TabbedPage"
        Title="Tabs">
        <Tab>
            <ShellContent
                Title="Tab One"
                ContentTemplate="{DataTemplate contentPages:TabbedPageOne}" />
            <ShellContent
                Title="Tab Two"
                ContentTemplate="{DataTemplate contentPages:TabbedPageTwo}" />
        </Tab>
    </FlyoutItem>
    
    <FlyoutItem 
        Route="FlyoutPageThree"
        Title="Replace Target">
        <ShellContent
            Title="Replace Target"
            ContentTemplate="{DataTemplate contentPages:FlyoutPageThree}"
            Route="FlyoutPageThree" />
    </FlyoutItem>
    
</Shell>
