<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Sample.ContentPages" x:Class="Sample.AppShell" Title="ShellInject Lab" FlyoutBehavior="Flyout">
    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{StaticResource Navy}" Padding="24,48,24,24" Spacing="12">
            <Image Source="lab_mark.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Start" />
            <Label Text="ShellInject" Style="{StaticResource Heading}" TextColor="White" />
            <Label Text="THE NAVIGATION LAB" Style="{StaticResource Eyebrow}" TextColor="{StaticResource AccentDark}" />
            <Label Text="Small examples. Complete workflows." Style="{StaticResource Caption}" TextColor="{StaticResource HeroText}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>
    <FlyoutItem Route="Lab" Title="Navigation lab">
        <ShellContent Title="Navigation lab" Route="MainPage" ContentTemplate="{DataTemplate pages:MainPage}" />
    </FlyoutItem>
    <FlyoutItem Route="Workspace" Title="Workspace · tabs">
        <Tab Title="Workspace" Route="WorkspaceTabs">
            <!-- Deliberately materialized: ChangeTabAsync<TPage> only searches created content. -->
            <ShellContent Title="Overview" Route="Overview"><pages:TabbedPageOne /></ShellContent>
            <ShellContent Title="Inbox" Route="Inbox"><pages:TabbedPageTwo /></ShellContent>
        </Tab>
    </FlyoutItem>
    <FlyoutItem Route="Dispatch" Title="Dispatch · replace">
        <!-- Materialize the parameter-receiving destination before ReplaceAsync's post-navigation callback. -->
        <ShellContent Title="Dispatch" Route="FlyoutPageThree"><pages:FlyoutPageThree /></ShellContent>
    </FlyoutItem>
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="24" Spacing="8">
            <Label Text="OPEN SOURCE / .NET MAUI 10" Style="{StaticResource Eyebrow}" />
            <Label Text="Start workflows in the lab to send data. Menu selections navigate without a new payload." Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
