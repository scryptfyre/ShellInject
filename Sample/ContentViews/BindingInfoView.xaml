<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:ShellInject.Extensions;assembly=ShellInject"
             xmlns:vm="clr-namespace:Sample.ViewModels"
             extensions:ShellInjectPageExtensions.ViewModelType="{x:Type vm:BindingInfoViewModel}"
             x:DataType="vm:BindingInfoViewModel"
             x:Class="Sample.ContentViews.BindingInfoView">
    <Border Style="{StaticResource ResultCard}">
        <VerticalStackLayout Spacing="12">
            <Label Text="LIVE EXAMPLE / REUSABLE CONTENTVIEW" Style="{StaticResource Eyebrow}" />
            <Label Text="{Binding Message}" />
            <Label Text="This card has its own BindingInfoViewModel, supplied by ViewModelType. It does not inherit GuideViewModel or receive page-navigation parameters." Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
