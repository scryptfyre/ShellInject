<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:ShellInject.Extensions;assembly=ShellInject"
             xmlns:vm="clr-namespace:Sample.ViewModels"
             extensions:ShellInjectPageExtensions.ViewModelType="{x:Type vm:DetailsViewModel}"
             x:Class="Sample.ContentViews.TestContentView">
    <Border BackgroundColor="#EEF2FF" Stroke="#C7D2FE" StrokeShape="RoundRectangle 16" Padding="16">
        <Label
            Text="ContentView sample: ViewModelType can also be attached to views when you want ShellInject-managed binding outside a page."
            TextColor="#3730A3"
            FontSize="13" />
    </Border>
</ContentView>
