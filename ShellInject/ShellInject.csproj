<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
        <!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>10.1.0</PackageVersion>
        <PackageId>ShellInject</PackageId>
        <Authors>Jamie Smith</Authors>
        <Copyright>ScryptFyre 2026</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
        <Owners>ScryptFyre</Owners>
        <Summary>.NET MAUI Shell navigation for MVVM. Navigate by page type and pass objects between ViewModels.</Summary>
        <Description>.NET MAUI Shell navigation for MVVM apps. Navigate by page type, pass objects to the next page, and return results to the previous one without string routes, QueryProperty, or IQueryAttributable. Pages and popups are bound to ViewModels automatically, ViewModels are resolved through dependency injection, and appearing, disappearing, and navigation data callbacks run in the ViewModel. Supports pushes, modals, tabs, flyout items, and CommunityToolkit popups.</Description>
        <PackageTags>maui;dotnet-maui;net-maui;shell;shell-navigation;navigation;mvvm;viewmodel;dependency-injection;popup;communitytoolkit;android;ios;maccatalyst</PackageTags>
        <Title>ShellInject - .NET MAUI Shell Navigation for MVVM</Title>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/scryptfyre/ShellInject</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scryptfyre/ShellInject</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>10.0.3</PackageValidationBaselineVersion>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <PackageReleaseNotes>
            • Added typed ViewModel data hooks and parameter-first generic push overloads
            • Added explicit ViewModel registrations and cached convention discovery
            • Added optional error reporting for recovered binding and lifecycle failures
            • Added typed selection for materialized tabs while preserving index-based navigation
            • Isolated popup tracking by Shell and preserved data across delayed lifecycle callbacks
            • Prefer exact page types for data delivery while retaining legacy name fallback
            • Added OnDisappearing alias without removing or obsoleting existing overrides
            • Preserved existing method signatures, extension wrappers, and public validation exception types
            • Validate package API compatibility against 10.0.3 and update SourceLink build tooling
        </PackageReleaseNotes>
        
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Package dependencies required by ShellInject for navigation, bindings, and popups. -->
        <PackageReference Include="Microsoft.Maui.Controls" Version="[10.0.80,)" />
        <PackageReference Include="CommunityToolkit.Maui" Version="[14.2.0,)" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.4.2,)" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Services\" />
    </ItemGroup>
    
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ShellInjectTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>


</Project>
